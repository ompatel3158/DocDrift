# ==============================================================================
# DocDrift Configuration (.env.example)
# ==============================================================================
# Copy this file to .env and configure your environment:
#   cp .env.example .env      (Linux/macOS)
#   copy .env.example .env    (Windows CMD)
#   Copy-Item .env.example .env (Windows PowerShell)

# Google Gemini API Key (Required for online Gemma 4 models)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemma 4 Model Selection (Strictly enforced: only Gemma 4 models supported)
# Options: gemma-4-26b-it (default) or gemma-4-31b-it
DOCDRIFT_MODEL=gemma-4-26b-it

# UltSQL Converged Memory Settings (optional)
# Set to 'false' to force the local SQLite fallback backend
DOCDRIFT_USE_ULTSQL=true
